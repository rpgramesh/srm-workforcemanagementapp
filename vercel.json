{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["syd1"],
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/((?!_next/static|_next/image|favicon.ico).*)", "destination": "/" }
  ]
}
